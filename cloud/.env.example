# Copy to .env.local. Never commit the real value — a leaked router key lets
# anyone spend Pagehand's credits (PLAN-subscription §2).
OPENROUTER_API_KEY=

# Optional. Comma-separated; defaults to the list in lib/config.ts.
# A plan gate, not a pricing one — the router reports cost per request.
HOSTED_MODEL_ALLOWLIST=

# Optional. Powers /api/v1/search for signed-in users who brought no key of
# their own. Unset means that endpoint answers 503 and every extension falls
# back to its keyless Bing path — search keeps working, less precisely.
# Costs credits per call (2 per 10 results against a 1,000/month allowance).
FIRECRAWL_API_KEY=
