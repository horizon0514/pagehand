node_modules/

# Local secrets — API keys live here and must never be committed.
# The glob matters: an editor swap file or a hand-made `.env.local.bak` carries
# exactly the same keys, and the narrow patterns below let one through once.
.env
.env.local
.env.*.local
.env*.local*

# The private half of the development signing key. Only the public half is
# needed to pin the extension id (it lives in manifest.config.ts), so losing
# this file costs nothing — but committing it would let anyone sign a build
# that claims the same id.
dev-key.pem

dist/
dist-*/
pagehand.zip
.DS_Store
*.log
.vite/
test-results/
playwright-report/
blob-report/
.playwright/

# Benchmark working files: the gated dataset cache and per-task trajectories
# (megabytes of screenshots). The pinned sample.json is committed.
e2e/benchmark/.cache/
e2e/benchmark/out/
.vercel/
