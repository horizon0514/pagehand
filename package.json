{
  "name": "pagehand",
  "version": "0.4.0",
  "private": true,
  "description": "Pagehand — AI that reads and automates the current tab via the Chrome DevTools Protocol.",
  "homepage": "https://pagehand.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/horizon0514/pagehand.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ext": "vite",
    "build": "tsc --noEmit && vite build",
    "pack": "PAGEHAND_STORE_BUILD=true npm run build && rm -f pagehand.zip && cd dist && zip -r ../pagehand.zip .",
    "store:shots": "node store/render-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "VITE_E2E=true vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "devtools-protocol": "^0.0.1672245",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
